<Window x:Class="LauncherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LauncherApp" 
        Title="My Launcher" 
        Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" 
        Background="Transparent" 
        WindowStyle="None"> 

    <!-- 外层 Border -->
    <Border CornerRadius="10" Background="#FF1E1E1E" BorderBrush="#FF333333" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/> <!-- 标题栏 -->
                <RowDefinition Height="*"/>   <!-- 主内容区 (Tabs) -->
            </Grid.RowDefinitions>

            <!-- ================= 自定义标题栏 ================= -->
            <Grid Grid.Row="0" Background="#FF2D2D2D" MouseLeftButtonDown="DragWindow_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="🎮 MyLauncher" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 最小化 -->
                    <Button Click="Minimize_Click" Width="46" Height="35" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Content>
                            <TextBlock Text="─" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Name="bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FF3E3E3E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- 关闭 -->
                    <Button Click="Close_Click" Width="46" Height="35" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Content>
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 6,6 L 18,18 M 18,6 L 6,18" Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Name="bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FFE81123"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= 主内容区域：TabControl ================= -->
            <TabControl Grid.Row="1" Margin="10,5,10,10" Background="Transparent" BorderThickness="0">
                
                <!-- 样式定义：让 TabItem 看起来更像 PCL/HMCL 的现代风格 -->
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#AAAAAA"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="15,5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="border" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FF3E3E3E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FF2D2D2D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- 1. 启动页 -->
                <TabItem Header="🚀 启动">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 顶部选择 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="当前版本:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="VersionBox" Width="150" Height="30" SelectedIndex="0" FontSize="13">
                                <ComboBoxItem Content="1.20.4"/>
                                <ComboBoxItem Content="1.19.2"/>
                                <ComboBoxItem Content="Snapshot"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 中间日志 -->
                        <Border Grid.Row="1" Background="#FF252525" CornerRadius="8" Padding="15" Margin="0,15,0,15">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="StatusLabel" 
                                           Text="就绪" 
                                           Foreground="#FFCCCCCC" 
                                           FontFamily="Consolas" 
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <!-- 底部按钮 -->
                        <Button Grid.Row="2" 
                                Content="立即启动游戏" 
                                HorizontalAlignment="Right"
                                Width="150" Height="40" 
                                FontSize="15" FontWeight="SemiBold"
                                Click="OnLaunchClick"
                                Background="#FF4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand">
                             <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Name="launchBtn" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="launchBtn" Property="Background" Value="#FF45a049"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                             </Button.Template>
                        </Button>
                    </Grid>
                </TabItem>

                <!-- 2. 下载页 -->
                <TabItem Header="⬇️ 下载">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 搜索/过滤栏 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="SearchBox" Width="200" Height="30" VerticalContentAlignment="Center" Padding="5" Text="搜索版本..."/>
                            <Button Content="刷新列表" Margin="10,0,0,0" Width="80" Height="30" Background="#FF3E3E3E" Foreground="White" BorderThickness="0"/>
                        </StackPanel>

                        <!-- 版本列表 (模拟 ListView) -->
                        <ListView Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="版本号" Width="150" DisplayMemberBinding="{Binding Version}"/>
                                    <GridViewColumn Header="类型" Width="100" DisplayMemberBinding="{Binding Type}"/>
                                    <GridViewColumn Header="状态" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="操作" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="下载" Width="60" Height="25" Background="#FF2196F3" Foreground="White" BorderThickness="0" Click="OnDownloadClick"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                            
                            <!-- 静态测试数据 -->
                            <ListViewItem>
                                <local:GameVersionInfo Version="1.20.4" Type="Release" Status="未安装"/>
                            </ListViewItem>
                            <ListViewItem>
                                <local:GameVersionInfo Version="1.19.2" Type="Release" Status="已安装"/>
                            </ListViewItem>
                            <ListViewItem>
                                <local:GameVersionInfo Version="24w14a" Type="Snapshot" Status="未安装"/>
                            </ListViewItem>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- 3. 设置页 -->
                <TabItem Header="⚙️ 设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="通用设置" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            
                            <CheckBox Content="记住密码" IsChecked="True" Foreground="#CCCCCC" Margin="0,5"/>
                            <CheckBox Content="自动检查更新" IsChecked="True" Foreground="#CCCCCC" Margin="0,5"/>
                            
                            <Separator Margin="0,10" Background="#333"/>
                            
                            <TextBlock Text="Java 路径" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="C:\Program Files\Java\jdk-17\bin\java.exe" Height="30" VerticalContentAlignment="Center" Padding="5"/>
                                <Button Grid.Column="1" Content="浏览..." Width="60" Height="30" Margin="5,0,0,0" Background="#FF3E3E3E" Foreground="White" BorderThickness="0"/>
                            </Grid>

                            <TextBlock Text="内存分配 (MB)" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,10,0,10"/>
                            <Slider Minimum="1024" Maximum="8192" Value="4096" TickFrequency="1024" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>
                            <TextBlock Text="4096 MB" Foreground="#AAAAAA" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 4. 关于页 -->
                <TabItem Header="ℹ️ 关于">
                    <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="MyLauncher Demo" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Version 1.0.0 Beta" FontSize="14" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                        
                        <TextBlock Text="这是一个基于 WPF (.NET 8+) 开发的简易 Minecraft 启动器原型。" 
                                   TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center" Foreground="#CCCCCC" Margin="0,0,0,20"/>
                        
                        <Hyperlink NavigateUri="https://github.com" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="查看源代码 (GitHub)" Foreground="#2196F3"/>
                        </Hyperlink>
                        
                        <TextBlock Text="© 2026 Developer Name. All rights reserved." 
                                   FontSize="10" Foreground="#666666" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</Window>